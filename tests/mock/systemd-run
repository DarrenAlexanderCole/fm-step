#!/usr/bin/env python3
"""Mock systemd-run: runs the command detached, then ExecStopPost, like a
transient unit with KillMode=control-group (it kills the unit's process group
before ExecStopPost)."""
import os, signal, subprocess, sys
S = os.environ["MOCK_STATE"]
argv = sys.argv[1:]; props = {}; unit = "run"; i = 0
while i < len(argv):
    a = argv[i]
    if a == "-p": k, v = argv[i + 1].split("=", 1); props[k] = v; i += 2; continue
    if a.startswith("--unit="): unit = a.split("=", 1)[1]; i += 1; continue
    if a.startswith("-"): i += 1; continue
    break
cmd = argv[i:]
with open(os.path.join(S, "calls.log"), "a") as f: f.write("systemd-run " + " ".join(sys.argv[1:]) + "\n")
if os.fork() > 0:
    sys.exit(0)
os.setsid()
if os.fork() > 0:
    os._exit(0)
devnull = os.open(os.devnull, os.O_RDWR)
for fd in (0, 1, 2): os.dup2(devnull, fd)
p = subprocess.Popen(cmd, start_new_session=True,
                     stderr=open(os.path.join(S, unit + ".stderr"), "a"))
open(os.path.join(S, unit + ".pid"), "w").write(str(p.pid))
rc = p.wait()
try: os.killpg(p.pid, signal.SIGKILL)
except Exception: pass
env = dict(os.environ, SERVICE_RESULT="success" if rc == 0 else ("signal" if rc < 0 else "exit-code"),
           EXIT_CODE="killed" if rc < 0 else "exited", EXIT_STATUS=str(abs(rc)))
if "ExecStopPost" in props:
    subprocess.call(props["ExecStopPost"], shell=True, env=env)
open(os.path.join(S, unit + ".done"), "w").write(str(rc))
